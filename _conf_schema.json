{
  "features": {
    "type": "list",
    "description": "功能开关",
    "hint": "从上游Config bool字段自动扫描",
    "options": [
      "Append Qrcode",
      "Append Url",
      "Headless",
      "Lazy Download",
      "Lazy Download Tip",
      "Live Photo",
      "Need Forward Contents",
      "Need Upload",
      "Need Upload Audio",
      "Need Upload Video",
      "Use Base64"
    ],
    "default": [
      "Live Photo",
      "Need Forward Contents"
    ]
  },
  "custom_parsers": {
    "type": "template_list",
    "description": "自定义解析器",
    "templates": {
      "default": {
        "name": "自定义",
        "items": {
          "_header": {
            "type": "text",
            "description": "── 基础配置 ──",
            "default": ""
          },
          "name": {
            "type": "string",
            "description": "解析器ID (唯一标识)"
          },
          "display": {
            "type": "string",
            "description": "显示名"
          },
          "url_pattern": {
            "type": "string",
            "description": "URL匹配正则"
          },
          "_extract": {
            "type": "text",
            "description": "── 内容提取 (留空=跳过) ──",
            "default": ""
          },
          "title_re": {
            "type": "string",
            "description": "标题正则",
            "default": ""
          },
          "author_re": {
            "type": "string",
            "description": "作者正则",
            "default": ""
          },
          "image_re": {
            "type": "string",
            "description": "图片正则",
            "default": ""
          },
          "video_re": {
            "type": "string",
            "description": "视频正则",
            "default": ""
          },
          "audio_re": {
            "type": "string",
            "description": "音频正则",
            "default": ""
          },
          "text_re": {
            "type": "string",
            "description": "正文正则",
            "default": ""
          },
          "cover_re": {
            "type": "string",
            "description": "封面正则",
            "default": ""
          },
          "timestamp_re": {
            "type": "string",
            "description": "时间戳正则",
            "default": ""
          },
          "_http": {
            "type": "text",
            "description": "── HTTP 配置 ──",
            "default": ""
          },
          "headers": {
            "type": "text",
            "description": "请求头(JSON)",
            "default": "{}"
          },
          "ajax": {
            "type": "bool",
            "description": "API模式(POST)",
            "default": false
          },
          "ajax_url": {
            "type": "string",
            "description": "API URL",
            "default": ""
          },
          "timeout": {
            "type": "int",
            "description": "超时(秒)",
            "default": 30
          },
          "encoding": {
            "type": "string",
            "description": "响应编码",
            "default": ""
          },
          "cookie": {
            "type": "string",
            "description": "Cookie",
            "default": ""
          },
          "ua": {
            "type": "string",
            "description": "User-Agent",
            "default": ""
          },
          "referer": {
            "type": "string",
            "description": "Referer",
            "default": ""
          },
          "_extras": {
            "type": "text",
            "description": "── 扩展参数 (键值对自由扩展) ──",
            "default": "{}"
          },
          "extras": {
            "type": "text",
            "description": "扩展参数(JSON)",
            "default": "{}",
            "hint": "任意键值对, 注入到请求配置"
          }
        }
      }
    }
  },
  "plite_max_size": {
    "description": "Max Size",
    "type": "int",
    "slider": {
      "min": 10,
      "max": 500,
      "step": 10
    },
    "default": 90
  },
  "plite_duration_maximum": {
    "description": "Duration Maximum",
    "type": "int",
    "slider": {
      "min": 60,
      "max": 3600,
      "step": 60
    },
    "default": 480
  },
  "plite_blacklist_users": {
    "description": "Blacklist Users",
    "type": "list",
    "items": {
      "type": "string"
    },
    "default": []
  },
  "plite_lazy_download_timeout": {
    "description": "Lazy Download Timeout",
    "type": "int",
    "default": 30
  },
  "plite_download_command": {
    "description": "Download Command",
    "type": "list",
    "items": {
      "type": "string"
    },
    "default": [
      "xz",
      "下载"
    ]
  },
  "plite_browser_path": {
    "description": "Browser Path",
    "type": "string",
    "default": ""
  },
  "plite_max_comments": {
    "description": "Max Comments",
    "type": "int",
    "slider": {
      "min": 0,
      "max": 20,
      "step": 1
    },
    "default": 5
  },
  "plite_forward_text_threshold": {
    "description": "Forward Text Threshold",
    "type": "int",
    "default": 1000
  },
  "plite_max_retries": {
    "description": "Max Retries",
    "type": "int",
    "slider": {
      "min": 0,
      "max": 5,
      "step": 1
    },
    "default": 3
  },
  "plite_day_range": {
    "description": "Day Range",
    "type": "list",
    "items": {
      "type": "string"
    },
    "default": [
      "6:00",
      "19:00"
    ]
  },
  "parsers": {
    "type": "object",
    "description": "解析器控制",
    "items": {
      "proxied": {
        "type": "list",
        "description": "走代理的解析器",
        "default": [],
        "items": {
          "type": "string"
        },
        "options": [
          "5eplay",
          "acfun",
          "bilibili",
          "buff",
          "coolapk",
          "douban",
          "doubao",
          "douyin",
          "duitang",
          "heybox",
          "hupu",
          "illu",
          "kuaishou",
          "kugou",
          "kuwo",
          "linuxdo",
          "lofter",
          "miyoushe",
          "netease",
          "qsmusic",
          "rednote",
          "tieba",
          "weibo",
          "wmpvp",
          "x",
          "zhihu"
        ]
      },
      "cookies": {
        "type": "string",
        "description": "Cookie映射(JSON)",
        "default": "{}",
        "hint": "语法: {\"平台名\":\"key1=val1; key2=val2\"}。例: {\"bilibili\":\"SESSDATA=xxx; bili_jct=yyy\",\"zhihu\":\"z_c0=zzz\"}。B站Cookie从浏览器F12→Application→Cookies→bilibili.com 复制。各平台独立，以分号分隔键值对"
      }
    }
  },
